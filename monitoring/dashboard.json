          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"campus-resource-hub\", pod=~\"campus-resource-hub-backend.*\"}) by (pod)",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ]
