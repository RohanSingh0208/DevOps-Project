      "title": "Backend Pod CPU Utilization",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"campus-resource-hub\", pod=~\"campus-resource-hub-backend.*\"}[1m])) by (pod)",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
